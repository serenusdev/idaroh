{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abba-os",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://iahicretctdwpjhxohio.supabase.co"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "abba-os"
    }
  ],
  "observability": {
    "enabled": true
  }
}

