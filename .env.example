# IDAROH - Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="IDAROH"

# Kontak admin (opsional) — ditampilkan di layar status akun (pending/ditolak/ditangguhkan).
# Bila kosong, layar menampilkan arahan umum tanpa tautan mati.
NEXT_PUBLIC_ADMIN_CONTACT_EMAIL=
NEXT_PUBLIC_ADMIN_WHATSAPP=

# Scheduled Jobs Security
CRON_SECRET=placeholder-cron-secret-32-chars-min

# Security & Verification (Cloudflare Turnstile)
# Secret divalidasi fail-closed di produksi; site key dipakai widget di klien.
TURNSTILE_SECRET_KEY=placeholder-turnstile-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=placeholder-turnstile-site-key

# Google Drive StorageAdapter — wajib di produksi untuk seluruh binary storage.
GDRIVE_SERVICE_ACCOUNT_JSON='{"type":"service_account","client_email":"service-account@example.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'
GDRIVE_ROOT_FOLDER_ID=placeholder-drive-folder-id

# Transactional email (Resend) — wajib di produksi.
# EMAIL_FROM harus memakai domain yang SUDAH verified di Resend (operator, lihat §3b runbook).
# Target pengirim IDAROH: noreply@mail.pondokabdurrahmanbinauf.web.id — verifikasi domain itu dulu sebelum dipakai.
RESEND_API_KEY=placeholder-resend-api-key
EMAIL_FROM="IDAROH <noreply@mail.pondokabdurrahmanbinauf.web.id>"

# Mobile & Push Notifications (FCM / Capacitor)
# Opsional: bila kosong, push disabled + warning eksplisit saat build produksi.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'
CAPACITOR_SERVER_URL=http://localhost:3000

# Monitoring (OPS-04) — opsional; drain alerting error produksi (Slack/Sentry/log drain)
OPS_ERROR_WEBHOOK_URL=

# Direct read-only connection (DX-01) — WAJIB di produksi.
# Pakai connection string URI pooler (bukan IP direct) supaya IPv4-only tetap bisa connect.
# Jalur baca tertype (Kysely) gagal dengan pesan jelas bila ini kosong; ia tidak memakai
# SUPABASE_SERVICE_ROLE_KEY sebagai cadangan.
SUPABASE_DB_URL=postgresql://postgres:placeholder-db-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# disable (lokal/CI) | no-verify (pooler lama) | verify-full (default, produksi)
SUPABASE_DB_SSL_MODE=verify-full
# Opsional: batas waktu statement analitik dalam ms (default 5000, dijepit 250–30000)
# DX01_STATEMENT_TIMEOUT_MS=5000

# E2E & Automation Testing
E2E_EMAIL=e2e-active@example.test
E2E_PASSWORD=Local-E2E-Password-2026
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
