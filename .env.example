# Pondok OS - Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Pondok OS"

# Kontak admin (opsional) — ditampilkan di layar status akun (pending/ditolak/ditangguhkan).
# Bila kosong, layar menampilkan arahan umum tanpa tautan mati.
NEXT_PUBLIC_ADMIN_CONTACT_EMAIL=
NEXT_PUBLIC_ADMIN_WHATSAPP=

# Scheduled Jobs Security
CRON_SECRET=placeholder-cron-secret-32-chars-min

# Security & Verification (Cloudflare Turnstile)
# Secret divalidasi fail-closed di produksi; site key dipakai widget di klien.
TURNSTILE_SECRET_KEY=placeholder-turnstile-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=placeholder-turnstile-site-key

# Transactional email (Resend) — wajib di produksi
RESEND_API_KEY=placeholder-resend-api-key
EMAIL_FROM="Pondok OS <no-reply@example.com>"

# Mobile & Push Notifications (FCM / Capacitor)
# Opsional: bila kosong, push disabled + warning eksplisit saat build produksi.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"..."}'
CAPACITOR_SERVER_URL=http://localhost:3000

# Monitoring (OPS-04) — opsional; drain alerting error produksi (Slack/Sentry/log drain)
OPS_ERROR_WEBHOOK_URL=

# E2E & Automation Testing
E2E_EMAIL=e2e-active@example.test
E2E_PASSWORD=Local-E2E-Password-2026
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
